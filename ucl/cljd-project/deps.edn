;; The ClojureDart project ucl/run-tests.sh and bb copy into a build directory:
;; sources go to src/ (tools.deps no longer takes paths outside a project).
{:paths ["src"]
 :deps {tensegritics/clojuredart
        {:git/url "https://github.com/tensegritics/ClojureDart.git"
         :sha "247b3c2c5f2af8378e49a8f1271fb4e45e4a6982"}}
 :aliases {:cljd {:main-opts ["-m" "cljd.build"]}}
 :cljd/opts {:kind :dart}}
