import 'BUILD.dart';
void main() {
  final xs = List<int>.generate(100000, (i) => 1 + (i * 7919) % 100000);
  final s = Solution();
  for (var i = 0; i < 20; i++) s.findNumbers(xs);
  final ws = <int>[]; dynamic r;
  for (var i = 0; i < 200; i++) { final sw = Stopwatch()..start(); r = s.findNumbers(xs); ws.add(sw.elapsedMicroseconds); }
  ws.sort(); print('{"v":"BUILD","warm":${ws[100]},"r":$r}');
}
