{:paths ["src" "test" "bb"]
 :deps {metosin/malli {:mvn/version "0.20.0"}}

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell process]]
             [clojure.string :as str]
             [tasks.git]
             [tasks.lc])

  :init (def project-root (fs/cwd))

  ;; ============================================================================
  ;; CLEAN
  ;; ============================================================================

  clean
  {:doc "Remove build output and ClojureScript caches"
   :task (tasks.lc/clean)}

  ;; ============================================================================
  ;; TESTS -- every host runs the same test files against ucl (ucl/README.md)
  ;; ============================================================================

  test-ucl
  {:doc "Run the ucl library suite on Clojure, ClojureScript, Squint and ClojureDart"
   :task (tasks.lc/test-ucl)}

  test-squint
  {:doc "Run the solution tests on Squint, bundled as LeetCode submissions are"
   :task (tasks.lc/test-squint)}

  test-clj
  {:doc "Run the solution tests on Clojure (JVM)"
   :task (tasks.lc/test-clj)}

  test-cljs
  {:doc "Run the solution tests on ClojureScript (warnings are errors)"
   :task (tasks.lc/test-cljs)}

  test-cljd
  {:doc "Run the solution tests on ClojureDart"
   :task (tasks.lc/test-cljd)}

  test
  {:doc "Run everything: ucl suite, then Squint -> Clojure -> ClojureScript -> ClojureDart"
   :task (do (run 'test-ucl)
             (run 'test-squint)
             (run 'test-clj)
             (run 'test-cljs)
             (run 'test-cljd)
             (println "\n✓ ALL TESTS PASSED ON ALL PLATFORMS"))}

  ;; ============================================================================
  ;; BUILDS -- LeetCode submissions: Squint at ucl safety 0, no test kit
  ;; ============================================================================

  build-one
  {:doc "Build one problem for LeetCode: bb build-one <problem>"
   :task (tasks.lc/build-one (first *command-line-args*))}

  build-all
  {:doc "Build every problem for LeetCode"
   :task (tasks.lc/build-all)}

  build
  {:doc "Alias for build-all"
   :task (tasks.lc/build-all)}

  ;; ============================================================================
  ;; GIT TASKS
  ;; ============================================================================

  git:plan
  {:doc "Show staged changes grouped by status"
   :task (tasks.git/plan *command-line-args*)}

  git:snapshot
  {:doc "Snapshot staged files to .git/commit-snapshot"
   :task (tasks.git/snapshot *command-line-args*)}

  git:commit
  {:doc "Commit staged content for listed paths using temp index"
   :task (tasks.git/commit *command-line-args*)}

  git:staged
  {:doc "List staged files with status"
   :task (tasks.git/staged *command-line-args*)}

  git:unstage
  {:doc "Unstage files (works for add/modify/delete)"
   :task (tasks.git/unstage *command-line-args*)}}}
