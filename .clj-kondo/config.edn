{;; ucl's definers and binders take Common Lisp lambda and binding lists, which clj-kondo cannot
 ;; analyze; LeetCode's ListNode/TreeNode are globals there (ucl/README.md §7). ucl.api's
 ;; macros come from `defapi`, which clj-kondo cannot expand: hooks/ucl_api.clj, generated by
 ;; ucl/kondo.clj, defines them with their docstrings; hooks/ucl_forms.clj gives what the
 ;; definers define (I54).
 :hooks {:macroexpand {ucl.contract/defapi     hooks.ucl-api/defapi
                       ucl.contract/defruntime hooks.ucl-forms/defruntime
                       ucl.api/defun           hooks.ucl-forms/defun
                       ucl.api/defmethod       hooks.ucl-forms/defmethod
                       ucl.api/defstruct       hooks.ucl-forms/defstruct}}
 :lint-as {ucl.test/deftest clojure.test/deftest}
 :linters {:unused-binding {:level :off}
           :unresolved-symbol {:exclude [ListNode TreeNode
                                         (ucl.api/defun)
                                         (ucl.api/defmethod)
                                         (ucl.api/defstruct)
                                         (ucl.api/with-slots)
                                         (ucl.api/let)
                                         (ucl.api/let*)
                                         (ucl.api/dotimes)
                                         (ucl.api/loop)]}}}
